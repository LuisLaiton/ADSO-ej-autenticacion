# Plantilla de variables de entorno.
# Copia las variables necesarias a api-autenticacion/.env y/o
# frontend-autenticacion/.env, según cómo las lea el código.
# Sustituye los valores de ejemplo y nunca pongas secretos reales aquí.

# --- Backend ---
PORT=3000

# Si el backend se conecta a una base de datos, define aquí las variables
# que realmente utilice tu código. Ejemplos (descomenta/adapta si aplica):
# DATABASE_URL=
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# Si utilizas JWT, configura una clave únicamente en el .env local del backend.
# No publiques el valor real ni lo uses en variables VITE_*.
# JWT_SECRET=

# --- Frontend (Vite) ---
# Las variables que Vite expone al navegador deben comenzar por VITE_.
# Ajusta el nombre al que use tu código, por ejemplo:
VITE_API_URL=http://localhost:3000
